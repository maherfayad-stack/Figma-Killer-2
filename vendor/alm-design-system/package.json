{
  "name": "alm-design-system",
  "version": "1.1.2-vendored",
  "description": "The ALM design system, vendored into Studio. Source lives in src/; dist/ is generated by scripts/sync-alm-design-system.ts — do not edit dist by hand.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./dist/index.css": "./dist/index.css",
    "./dist/tokens.generated.json": "./dist/tokens.generated.json",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "studio",
    "CLAUDE.md",
    "design.md"
  ],
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
